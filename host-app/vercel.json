{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/remoteEntry.js",
            "destination": "/remoteEntry.js"
        },
        {
            "source": "/(.*).js",
            "destination": "/$1.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}